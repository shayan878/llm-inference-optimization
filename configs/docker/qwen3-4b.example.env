# Copy to local.env and edit MODEL_PATH before running.
# Use shell assignment syntax; scripts/start-vllm.sh sources this file.

VLLM_IMAGE=vllm/vllm-openai:v0.13.0
CONTAINER_NAME=vllm-qwen3-4b
MODEL_PATH=/absolute/path/to/Qwen3_4b
SERVED_MODEL_NAME=local-qwen3-4b
HOST_PORT=8000
CONTAINER_PORT=8000
DTYPE=float16
MAX_MODEL_LEN=1024
GPU_MEMORY_UTILIZATION=0.30
CACHE_VOLUME=vllm-cache
